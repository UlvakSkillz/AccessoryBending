<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RumblePath Condition="$([MSBuild]::IsOSPlatform('Windows'))">F:\SteamLibrary\steamapps\common\RUMBLE</RumblePath>
    <RumblePath Condition="$([MSBuild]::IsOSPlatform('Linux'))">/mnt/c/Program Files (x86)/Steam/steamapps/common/RUMBLE</RumblePath>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(RumblePath)/Mods')">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(RumblePath)/Mods/" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll to $(RumblePath)/Mods/" />
  </Target>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(RumblePath)/MelonLoader/net6/0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppBucketheadEntertainment.Plugins">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/Il2CppBucketheadEntertainment.Plugins.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(RumblePath)/MelonLoader/net6/Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppPhoton3Unity3D">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/Il2CppPhoton3Unity3D.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppPhotonRealtime">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/Il2CppPhotonRealtime.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppPhotonUnityNetworking">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/Il2CppPhotonUnityNetworking.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppRUMBLE.Plugins">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/Il2CppRUMBLE.Plugins.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppRUMBLE.Runtime">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/Il2CppRUMBLE.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>$(RumblePath)/MelonLoader/net6/MelonLoader.dll</HintPath>
    </Reference>
    <Reference Include="RumbleModdingAPI">
      <HintPath>$(RumblePath)/Mods/RumbleModdingAPI.dll</HintPath>
    </Reference>
    <Reference Include="UIFramework">
      <HintPath>$(RumblePath)/Mods/UIFramework.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RumblePath)/MelonLoader/Il2CppAssemblies/UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
